# Environment Configuration Template
# DO NOT store real secrets in this file. Copy to .env for local configuration.

DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production-use-a-strong-random-key

# Allowed Hosts & Domains (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,.schoolsaas.local,.myschoolsaas.com
BASE_TENANT_DOMAIN=myschoolsaas.com

# Database Configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=school_saas_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Token Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Redis Cache & Broker (Optional in local dev)
REDIS_URL=redis://127.0.0.1:6379/1
